# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# @type=bitwardenAccessToken @sensitive
BITWARDEN_ACCESS_TOKEN=

# @sensitive @required @type=string
# National Park Service API key — stored in Bitwarden Secrets Manager
# Replace the UUID below with the one from your Bitwarden secret
NPS_API_KEY=bitwarden("00000000-0000-0000-0000-000000000000")
