# @plugin(@varlock/pass-plugin)
# @initPass()
# ---
# @preventLeaks=false

# National Park Service API key
# @sensitive @required @type=string
NPS_API_KEY=pass("nps/api-key")

# Supabase URL
NEXT_PUBLIC_SUPABASE_URL=pass("parkreach/supabase-url")

# Supabase anon key
# @sensitive @required @type=string
NEXT_PUBLIC_SUPABASE_ANON_KEY=pass("parkreach/supabase-anon-key")

# Google Maps API key — server-side (Distance Matrix)
# @sensitive @required @type=string
GOOGLE_MAPS_API_KEY=pass("parkreach/google-maps-key")

# Google Maps API key — browser-facing (Maps JS API)
# @sensitive @required @type=string
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=pass("parkreach/google-maps-key")

# Cron job secret — used by Vercel cron runner to authenticate sync requests
# @sensitive @required @type=string
CRON_SECRET=pass("parkreach/cron-secret")

# Upstash Redis — REST API URL (auto-provisioned by Vercel Marketplace)
KV_REST_API_URL=pass("parkreach/upstash-redis-rest-url")

# Upstash Redis — REST API token
# @sensitive @required @type=string
KV_REST_API_TOKEN=pass("parkreach/upstash-redis-rest-token")

# Production site URL — used for auth redirects (magic link email callback)
NEXT_PUBLIC_SITE_URL=pass("parkreach/site-url")
