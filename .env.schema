# @plugin(@varlock/pass-plugin)
# @initPass()
# ---
# @preventLeaks=false

# National Park Service API key
# @sensitive @required @type=string
NPS_API_KEY=pass("nps/api-key")

# Supabase URL - public project reference
NEXT_PUBLIC_SUPABASE_URL=pass("parkreach/supabase-url")

# Supabase anon key - safe for client-side use
# @sensitive @required @type=string
NEXT_PUBLIC_SUPABASE_ANON_KEY=pass("parkreach/supabase-anon-key")

# Google Maps API key - used for Distance Matrix API (server-side)
# @sensitive @required @type=string
GOOGLE_MAPS_API_KEY=pass("parkreach/google-maps-key")

# Google Maps API key - exposed to browser for Maps JS API
# @sensitive @required @type=string
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=pass("parkreach/google-maps-key")

# Google Maps Map ID - created in Google Cloud Console → Maps → Map Management
# @type=string
# NEXT_PUBLIC_GOOGLE_MAP_ID=pass("parkreach/google-map-id")
